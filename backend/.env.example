JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_MINUTES=480
FRONTEND_ORIGIN=http://localhost:3000

# Optional — enables the LangChain "Get AI take" / recommendation generation.
# Leave unset to run on the deterministic fallback in store.py.
ANTHROPIC_API_KEY=

# Optional — enables seeding from Postgres instead of seed_data.py's literals.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
